{
  "mcpServers": {
    "overclock": {
      "command": "sh",
      "args": ["${CLAUDE_PLUGIN_ROOT:-.}/bin/mcp-launch.sh"],
      "env": {
        "RPC_URL": "${RPC_URL:-https://rpc.xlayer.tech}",
        "OVERCLOCK": "${OVERCLOCK:-}",
        "OVERCLOCK_PRIVATE_KEY": "${OVERCLOCK_PRIVATE_KEY:-}"
      }
    }
  }
}
